{
  "name": "discord-fake-game-launcher-ui",
  "private": true,
  "version": "0.2.1",
  "description": "Discord Fake Game Launcher for Quest Tracking",
  "author": "Morphy137",
  "repository": {
    "type": "git",
    "url": "https://github.com/Morphy137/ds-fake-game-launcher.git"
  },
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "sync:gamelist": "node ./scripts/sync-gamelist.js",
    "build:dummy": "dotnet publish ../src/DummyGame/DummyGame.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:EnableCompressionInSingleFile=true -o ./build-resources/dummygame",
    "build:launcher": "dotnet build ../src/Launcher/Launcher.csproj -c Release",
    "test": "node --test",
    "dist": "npm run build:dummy && electron-builder --win nsis --publish never",
    "dist:portable": "npm run build:dummy && electron-builder --win portable --publish never",
    "dist:all": "npm run build:dummy && electron-builder --win nsis portable --publish never",
    "dist:publish": "npm run build:dummy && electron-builder --win nsis portable --publish always"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.morphy137.discordfakegamelauncher",
    "productName": "Discord Fake Game Launcher",
    "files": [
      "src/**"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "build-resources/dummygame",
        "to": "dummygame",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "src/assets/app-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Morphy137",
        "repo": "ds-fake-game-launcher"
      }
    ],
    "nsis": {
      "artifactName": "Discord-Fake-Game-Launcher-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Discord Fake Game Launcher"
    },
    "portable": {
      "artifactName": "Discord-Fake-Game-Launcher-Portable-${version}.${ext}"
    }
  }
}
